{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated shopper profile, country/language preferences, and account status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Display name (1-80 chars)." },
        "preferredLanguage": { "type": "string", "description": "ISO language code (e.g. en, de, ja)." },
        "countryCode": { "type": "string", "description": "ISO 3166-1 alpha-2 country code (e.g. US, GB, JP)." },
        "currencyCode": { "type": "string", "description": "ISO 4217 display currency code (e.g. USD, GBP, JPY)." },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "DELETION_REQUESTED", "SUSPENDED"] },
        "marketingConsent": { "type": "boolean", "description": "Explicit user opt-in for promotional notifications." },
        "darkThemeEnabled": { "type": "boolean", "description": "Optional dark theme preference." },
        "reducedMotionEnabled": { "type": "boolean", "description": "Accessibility reduced motion preference." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId",
        "displayName",
        "preferredLanguage",
        "countryCode",
        "currencyCode",
        "accountStatus",
        "marketingConsent",
        "darkThemeEnabled",
        "reducedMotionEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScanRecord": {
      "title": "ScanRecord",
      "description": "Barcode scan event with source attribution and lookup outcome.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "barcodeValue": { "type": "string" },
        "barcodeFormat": { "type": "string" },
        "productName": { "type": "string" },
        "brand": { "type": "string" },
        "sourceProvider": { "type": "string" },
        "verificationStatus": {
          "type": "string",
          "enum": ["VERIFIED_MERCHANT", "LICENSED_PROVIDER", "OPEN_FOOD_FACTS", "USER_SUBMITTED_UNVERIFIED", "UNKNOWN"]
        },
        "scanResult": { "type": "string", "enum": ["MATCHED", "NOT_FOUND", "INVALID"] },
        "scannedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId",
        "barcodeValue",
        "barcodeFormat",
        "productName",
        "brand",
        "sourceProvider",
        "verificationStatus",
        "scanResult",
        "scannedAt"
      ]
    },
    "RewardWallet": {
      "title": "RewardWallet",
      "description": "User sandbox points wallet projection derived from verified ledger actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "unitCode": { "type": "string", "enum": ["PTS"] },
        "availablePoints": { "type": "integer" },
        "pendingPoints": { "type": "integer" },
        "redeemedPoints": { "type": "integer" },
        "reversedPoints": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "unitCode",
        "availablePoints",
        "pendingPoints",
        "redeemedPoints",
        "reversedPoints",
        "updatedAt"
      ]
    },
    "RewardTransaction": {
      "title": "RewardTransaction",
      "description": "Immutable reward ledger entry with idempotency and audit references.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "transactionType": { "type": "string", "enum": ["CAMPAIGN_BONUS", "RECEIPT_REWARD", "REDEMPTION", "REVERSAL"] },
        "amount": { "type": "integer" },
        "unitCode": { "type": "string", "enum": ["PTS"] },
        "sourceActivity": { "type": "string" },
        "campaignId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "CREDITED", "REDEEMED", "REJECTED", "EXPIRED", "REVERSED"] },
        "idempotencyKey": { "type": "string" },
        "auditReference": { "type": "string" },
        "relatedTransactionId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "transactionType",
        "amount",
        "unitCode",
        "sourceActivity",
        "status",
        "idempotencyKey",
        "auditReference",
        "createdAt"
      ]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification for reward changes, receipt reviews, security, and consented campaigns.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["REWARD_STATUS", "CAMPAIGN_ANNOUNCEMENT", "RECEIPT_REVIEW", "SECURITY_ALERT", "ACCOUNT"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "referenceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "title", "body", "read", "createdAt"]
    },
    "ReceiptSubmission": {
      "title": "ReceiptSubmission",
      "description": "Submitted retail receipt queued for human/admin verification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "storeName": { "type": "string" },
        "transactionDate": { "type": "string" },
        "currencyCode": { "type": "string" },
        "totalAmount": { "type": "number" },
        "receiptReference": { "type": "string" },
        "receiptReferenceHash": { "type": "string" },
        "campaignId": { "type": "string" },
        "reviewStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "rejectionReason": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "storeName",
        "transactionDate",
        "currencyCode",
        "totalAmount",
        "receiptReference",
        "receiptReferenceHash",
        "reviewStatus",
        "submittedAt",
        "updatedAt"
      ]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Promotional sandbox reward campaign with country, barcode, and budget rules.",
      "type": "object",
      "properties": {
        "partnerId": { "type": "string" },
        "partnerName": { "type": "string" },
        "title": { "type": "string" },
        "terms": { "type": "string" },
        "rewardType": { "type": "string", "enum": ["SANDBOX_POINTS"] },
        "rewardPoints": { "type": "integer" },
        "maxPerUser": { "type": "integer" },
        "budgetLimitPoints": { "type": "integer" },
        "eligibleCountries": { "type": "array" },
        "eligibleBarcodes": { "type": "array" },
        "eligibleCategories": { "type": "array" },
        "status": { "type": "string", "enum": ["DRAFT", "REVIEW", "APPROVED", "ACTIVE", "PAUSED", "EXPIRED", "ARCHIVED"] },
        "startAt": { "type": "string", "format": "date-time" },
        "endAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "partnerId",
        "partnerName",
        "title",
        "terms",
        "rewardType",
        "rewardPoints",
        "maxPerUser",
        "budgetLimitPoints",
        "eligibleCountries",
        "eligibleBarcodes",
        "eligibleCategories",
        "status",
        "startAt",
        "endAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Attributed product record from verified merchants, licensed feeds, Open Food Facts, or unverified user submissions.",
      "type": "object",
      "properties": {
        "barcode": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "manufacturer": { "type": "string" },
        "countryOfOrigin": { "type": "string" },
        "dataProvider": { "type": "string" },
        "attributionText": { "type": "string" },
        "verificationStatus": {
          "type": "string",
          "enum": ["VERIFIED_MERCHANT", "LICENSED_PROVIDER", "OPEN_FOOD_FACTS", "USER_SUBMITTED_UNVERIFIED"]
        },
        "submittedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "barcode",
        "name",
        "brand",
        "category",
        "description",
        "imageUrl",
        "manufacturer",
        "countryOfOrigin",
        "dataProvider",
        "attributionText",
        "verificationStatus",
        "submittedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProductOffer": {
      "title": "ProductOffer",
      "description": "Store price comparison record with verification flag and timestamp.",
      "type": "object",
      "properties": {
        "barcode": { "type": "string" },
        "storeName": { "type": "string" },
        "price": { "type": "number" },
        "currencyCode": { "type": "string" },
        "countryCode": { "type": "string" },
        "availabilityStatus": { "type": "string", "enum": ["IN_STOCK", "LIMITED", "OUT_OF_STOCK", "UNVERIFIED"] },
        "verified": { "type": "boolean" },
        "offerUrl": { "type": "string" },
        "submittedBy": { "type": "string" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "barcode",
        "storeName",
        "price",
        "currencyCode",
        "countryCode",
        "availabilityStatus",
        "verified",
        "offerUrl",
        "submittedBy",
        "lastVerifiedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Role-based administrative permission assignment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roleName": { "type": "string", "enum": ["SUPER_ADMIN", "RECEIPT_REVIEWER", "CAMPAIGN_MANAGER", "CATALOG_MANAGER"] },
        "permissions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roleName", "permissions", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit trail record.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "action", "entityType", "entityId", "reason", "timestamp"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "User account deletion request record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["REQUESTED", "COMPLETED"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "reason", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and localization/accessibility preferences."
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": { "$ref": "#/entities/ScanRecord" },
      "description": "User-scoped barcode scan history."
    },
    "/users/{userId}/wallet/{walletDocId}": {
      "schema": { "$ref": "#/entities/RewardWallet" },
      "description": "User rewards wallet summary document (walletDocId = summary)."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/RewardTransaction" },
      "description": "Immutable user reward ledger transactions."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User-scoped notification inbox."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/ReceiptSubmission" },
      "description": "Receipt verification submissions reviewed by authorized admins."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Promotional sandbox reward campaigns."
    },
    "/products_catalog/{barcode}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Product catalog entries keyed by normalized barcode."
    },
    "/products_catalog/{barcode}/offers/{offerId}": {
      "schema": { "$ref": "#/entities/ProductOffer" },
      "description": "Country-aware store price offers for a catalog product."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "RBAC admin roles."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/deletion_requests/{requestId}": {
      "schema": { "$ref": "#/entities/DeletionRequest" },
      "description": "User account deletion requests."
    }
  }
}
